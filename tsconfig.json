{
"compilerOptions": {
"target": "ES2020",
"module": "CommonJS",

"rootDir": "./src",
"outDir": "./dist",

"types": ["node"],

"sourceMap": true,

"strict": true,
"esModuleInterop": true,
"forceConsistentCasingInFileNames": true,

"noUncheckedIndexedAccess": true,
"exactOptionalPropertyTypes": true,

"skipLibCheck": true

},
"include": ["src"],
"exclude": ["node_modules", "dist"]
}
